{
  "name": "playwright-tests",
  "version": "1.0.0",
  "description": "Playwright tests",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "json-server --static . --watch data.json",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox --project=e2e-webkit",
    "test:e2e:chrome": "playwright test --project=e2e-chromium",
    "test:e2e:firefox": "playwright test --project=e2e-firefox",
    "test:e2e:webkit": "playwright test --project=e2e-webkit",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "json-server": "0.16.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "prettier": "2.2.1",
    "start-server-and-test": "1.12.0",
    "typescript": "7.0.2"
  }
}
